{
  "name": "zerogramjs",
  "version": "2.3.0",
  "description": "Framework moderno y elegante para crear bots de Telegram con Node.js y TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "lib/",
    "shared/",
    "utils/",
    "index.js",
    "index.d.ts",
    "banner.jpg",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:stress": "node --import tsx --test test/stress.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "telegram",
    "bot",
    "telegram-bot-api",
    "mtproto",
    "gramjs",
    "nodejs",
    "typescript"
  ],
  "author": "UserZero075",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UserZero075/ZerogramJS.git"
  },
  "bugs": {
    "url": "https://github.com/UserZero075/ZerogramJS/issues"
  },
  "homepage": "https://github.com/UserZero075/ZerogramJS#readme",
  "dependencies": {
    "big-integer": "^1.6.52",
    "debug": "4.4.3",
    "telegram": "2.26.22"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
